<link rel="stylesheet" href="/css/index-page.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap" rel="stylesheet">

<div class="index-page-container">
    <div class="hero-section">
        <h1>HAYALİNDEKİ ÜNİVERSİTE İÇİN <strong>ZERO AKADEMİ</strong></h1>
        <img src="https://res.cloudinary.com/dj8prtw8j/image/upload/v1751984497/ComfyUI_00067_v4_aoyjlm.png" alt="Zero Akademi Logo" class="hero-logo">
    </div>
    <section id="countdown-section" class="full-width-section">
        <div id="countdown">
            <h2 id="counterTitle">2026 YKS'YE KALAN SÜRE</h2>
            <div class="timer">
                <div id="days"></div>
                <div id="hours"></div>
                <div id="minutes"></div>
                <div id="seconds"></div>
            </div>
            <h3>Hayalindeki üniversite için geç kalma!</h3>
        </div>
    </section>
    <section class="whatsapp-contact full-width-section">
        <div class="contact-box">
            <i class="fa-brands fa-whatsapp fa-3x"></i>
            <h3>Bizimle İletişime Geçin</h3>
            <p>Aklınızdaki soruları sormak, <strong>ücretsiz soru çözümü ve tavsiyelerimizden</strong> faydalanmak için topluluğumuza katılın.</p>
            <a href="https://chat.whatsapp.com/Bh1VwlLxqgsFbFiu5KqSUe" class="whatsapp-button" target="_blank">Topluluğa Katıl!</a>
        </div>
    </section>

    <section class="features-section">
        <div class="features-container">
            <h2 class="section-title">Neler Yapıyoruz?</h2>
            <div class="features-grid">
                <div class="feature-box">
                    <i class="fas fa-user-tie fa-2x"></i>
                    <h3>Deneyimli Kadro</h3>
                    <p>Hedeflerinize ulaşmakta daha emin adımlar atın; alanında uzman ve deneyimli koçlarımızla başarıya giden yolda ilerleyin.</p>
                </div>
                <div class="feature-box">
                    <i class="fas fa-question-circle fa-2x"></i>
                    <h3>Soru Çözüm</h3>
                    <p>Takıldığınız her soruya anında çözüm desteği bulun ve farklı soru tipleri için etkili çözüm yolları öğrenerek netlerinizi hızla artırın.</p>
                </div>
                <div class="feature-box">
                    <i class="fas fa-calendar-check fa-2x"></i>
                    <h3>Günlük Program</h3>
                    <p>Hazırlık sürecinizi en verimli şekilde yönetmek için size özel, gerçekçi ve kolayca takip edilebilir günlük çalışma programlarından faydalanın.</p>
                </div>
                <div class="feature-box">
                    <i class="fas fa-comments fa-2x"></i>
                    <h3>Anlık Mesajlaşma</h3>
                    <p>Koçunuzla doğrudan ve hızlı iletişim kurarak aklınızdaki tüm soruları anında sorun, motivasyon ve rehberlik desteği alın.</p>
                </div>
                <div class="feature-box">
                    <i class="fas fa-magnifying-glass-chart fa-2x"></i>
                    <h3>Konu – Kaynak Analizi</h3>
                    <p>Eksik olduğunuz konuları birlikte belirleyelim; seviyenize ve hedeflerinize en uygun, güncel kaynakları birlikte seçerek ilerleyin.</p>
                </div>
                <div class="feature-box">
                    <i class="fas fa-chart-line fa-2x"></i>
                    <h3>Detaylı Rapor</h3>
                    <p>Performansınızı düzenli olarak takip edin; deneme sınavı sonuçlarınız ve gelişiminiz hakkında detaylı raporlar alarak stratejinizi sürekli güncel tutun.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="coaches-carousel-section">
        <h2 class="section-title">Koçlarımızı Keşfedin</h2>
        <div class="carousel-container">
            <div class="carousel-track">
                <% if (typeof coaches !== 'undefined' && coaches.length > 0) { %>
                    <% coaches.forEach(coach => { %>
                        <a href="/coaches" class="coach-card">
                            <img src="<%= coach.coachPicture.url %>" alt="<%= coach.name %>">
                            <h4><%= coach.name %></h4>
                            <p><%= coach.university %></p>
                            <p>Sıralama: <%= coach.score %></p>
                        </a>
                    <% }); %>
                    <!-- Duplicate for seamless loop -->
                    <% coaches.forEach(coach => { %>
                        <a href="/coaches" class="coach-card">
                            <img src="<%= coach.coachPicture.url %>" alt="<%= coach.name %>">
                            <h4><%= coach.name %></h4>
                            <p><%= coach.university %></p>
                            <p>Sıralama: <%= coach.score %></p>
                        </a>
                    <% }); %>
                <% } else { %>
                    <p>Koç bulunamadı.</p>
                <% } %>
            </div>
        </div>
    </section>
</div>
<script src="/js/index-page.js"></script>
